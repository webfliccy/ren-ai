# Set a strong random secret for admin access
ADMIN_SECRET=change-me

# Local SQLite is used by default (file:local.db)
# For Turso cloud, set these:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Public site URL for sitemaps, OG tags, and RSS
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Auth.js — generate with: npx auth secret
AUTH_SECRET=your-auth-secret

# GitHub OAuth app (https://github.com/settings/developers)
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth app (https://console.cloud.google.com)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# S3 file uploads — all four are required for uploads to work
# AWS region where the bucket lives (e.g. us-east-1)
AWS_REGION=us-east-1
# IAM credentials with s3:PutObject permission on the bucket (server-side only)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Name of the S3 bucket (server-side only)
S3_BUCKET=your-bucket-name
# Public base URL of the bucket (or CloudFront distribution) — exposed to the browser
NEXT_PUBLIC_S3_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com
