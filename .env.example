# Set a strong random secret for admin access
ADMIN_SECRET=change-me

# Local SQLite is used by default (file:local.db)
# For Turso cloud, set these:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Public site URL for sitemaps, OG tags, and RSS
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Auth.js — generate with: npx auth secret
AUTH_SECRET=your-auth-secret

# GitHub OAuth app (https://github.com/settings/developers)
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth app (https://console.cloud.google.com)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
